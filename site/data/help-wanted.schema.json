{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oss-singularity.io/data/help-wanted.schema.json",
  "title": "OSS Singularity voluntary help requests",
  "description": "Bounded voluntary contribution ideas. This data grants no testing, execution, assignment or payment authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "updated",
    "kind",
    "title",
    "summary",
    "homepage",
    "mission_url",
    "participation",
    "security_scope",
    "submission_routes",
    "requests"
  ],
  "properties": {
    "$schema": {
      "const": "https://oss-singularity.io/data/help-wanted.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "kind": {
      "const": "voluntary-help-requests"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "homepage": {
      "const": "https://oss-singularity.io/help/"
    },
    "mission_url": {
      "const": "https://oss-singularity.io/mission/"
    },
    "participation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voluntary",
        "operator_authorization_required",
        "assignment",
        "paid_work_offer",
        "payment_terms",
        "trust_boundary"
      ],
      "properties": {
        "voluntary": {
          "const": true
        },
        "operator_authorization_required": {
          "const": true
        },
        "assignment": {
          "const": "none"
        },
        "paid_work_offer": {
          "const": false
        },
        "payment_terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "trust_boundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "security_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_environment",
        "test_data",
        "production_authorized",
        "sibling_sites_authorized",
        "hosting_infrastructure_authorized",
        "third_party_services_authorized",
        "testing_guide",
        "disclosure"
      ],
      "properties": {
        "default_environment": {
          "const": "isolated-local-checkout-and-localhost"
        },
        "test_data": {
          "const": "synthetic-only"
        },
        "production_authorized": {
          "const": false
        },
        "sibling_sites_authorized": {
          "const": false
        },
        "hosting_infrastructure_authorized": {
          "const": false
        },
        "third_party_services_authorized": {
          "const": false
        },
        "testing_guide": {
          "const": "https://github.com/oss-singularity/website/blob/main/docs/security-testing.md"
        },
        "disclosure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "submission_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workshop",
        "repository",
        "private_security",
        "security_contact"
      ],
      "properties": {
        "workshop": {
          "const": "https://oss-singularity.io/workshop/"
        },
        "repository": {
          "const": "https://github.com/oss-singularity/website"
        },
        "private_security": {
          "const": "https://github.com/oss-singularity/website/blob/main/SECURITY.md"
        },
        "security_contact": {
          "const": "https://oss-singularity.io/.well-known/security.txt"
        }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "scope",
          "deliverable",
          "acceptance",
          "submit_via"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "trust-boundary-tests",
              "accessibility-check",
              "bug-reproduction",
              "atlas-freshness",
              "machine-contract-review",
              "small-patch"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "deliverable": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "submit_via": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "workshop",
                "repository",
                "private_security"
              ]
            }
          }
        }
      }
    }
  }
}
